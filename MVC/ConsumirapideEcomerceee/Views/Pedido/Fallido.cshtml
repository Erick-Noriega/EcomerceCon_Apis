@{
    ViewData["Title"] = "Pago No Realizado";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Encabezado con estado -->
                <div class="card-header bg-danger bg-gradient text-white text-center py-4 border-0">
                    <div class="mb-3">
                        <i class="bi bi-x-circle-fill display-1"></i>
                    </div>
                    <h2 class="fw-bold m-0">¡Pago no procesado!</h2>
                </div>

                <!-- Cuerpo del mensaje -->
                <div class="card-body p-4 text-center">
                    <p class="fs-5 text-secondary">
                        Hubo un problema al intentar procesar tu pago con Mercado Pago. No te preocupes, **no se ha realizado ningún cargo** en tu cuenta.
                    </p>

                    <hr class="my-4 text-muted opacity-25">

                    <div class="bg-light p-3 rounded-3 mb-4 text-start">
                        <h6 class="fw-bold text-dark mb-2"> Motivos habituales:</h6>
                        <ul class="text-muted mb-0 small ps-3">
                            <li>Fondos insuficientes o límite de tarjeta alcanzado.</li>
                            <li>Datos de la tarjeta o fecha de vencimiento incorrectos.</li>
                            <li>Rechazo preventivo por parte del banco emisor.</li>
                        </ul>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a href="@Url.Action("Carrito", "Pedido")" class="btn btn-danger btn-lg px-4 rounded-pill shadow-sm">
                            <i class="bi bi-arrow-counterclockwise me-2"></i>Reintentar Pago
                        </a>
                        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                            <i class="bi bi-house-door me-2"></i>Volver al Inicio
                        </a>
                    </div>
                </div>

                <!-- Pie Informativo -->
                <div class="card-footer bg-light text-center py-3 border-0">
                    <small class="text-muted">
                        ¿Necesitas ayuda con tu compra? <a href="/Contacto" class="text-decoration-none fw-semibold">Contáctanos</a>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons (Asegúrate de tenerlos en tu _Layout.cshtml o agrégalos aquí) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">