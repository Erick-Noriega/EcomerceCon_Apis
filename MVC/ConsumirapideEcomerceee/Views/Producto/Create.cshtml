@model CrearProductoDto


<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card bg-dark border-secondary shadow-lg rounded-4 overflow-hidden text-white">

                <!-- Encabezado de la Tarjeta -->
                <div class="card-header bg-black border-bottom border-secondary py-3 px-4">
                    <h4 class="mb-0 fw-bold text-white">
                        <i class="bi bi-plus-circle-fill text-primary me-2"></i>Crear Producto
                    </h4>
                    <p class="text-secondary small mb-0 mt-1">Completa los datos para registrar un nuevo producto.</p>
                </div>

                <!-- Cuerpo del Formulario -->
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <!-- Resumen de validación -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                        <!-- Nombre -->
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label text-secondary small fw-bold mb-1" style="font-size: 0.75rem;"></label>
                            <input asp-for="Nombre" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" placeholder="Ej. Remera Oversize" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <!-- Precio -->
                        <div class="mb-3">
                            <label asp-for="Precio" class="form-label text-secondary small fw-bold mb-1" style="font-size: 0.75rem;"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary">$</span>
                                <input asp-for="Precio" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>

                        <!-- Cantidad -->
                        <div class="mb-3">
                            <label asp-for="Cantidad" class="form-label text-secondary small fw-bold mb-1" style="font-size: 0.75rem;"></label>
                            <input asp-for="Cantidad" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" placeholder="Stock disponible" required />
                            <span asp-validation-for="Cantidad" class="text-danger small"></span>
                        </div>

                        <!-- Categoría Id (Select) -->
                        <div class="mb-3">
                            <label asp-for="CategoriaId" class="form-label text-secondary small fw-bold mb-1" style="font-size: 0.75rem;"></label>
                            <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select bg-secondary bg-opacity-10 text-white border-secondary">
                                <option value="">-- Seleccione una categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>

                        <!-- Descripción -->
                        <div class="mb-3">
                            <label asp-for="descripcion" class="form-label text-secondary small fw-bold mb-1" style="font-size: 0.75rem;"></label>
                            <textarea asp-for="descripcion" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" rows="3" placeholder="Detalles del producto..."></textarea>
                            <span asp-validation-for="descripcion" class="text-danger small"></span>
                        </div>

                        <!-- Imagen URL -->
                        <div class="mb-4">
                            <label asp-for="ImagenUrl" class="form-label text-secondary small fw-bold mb-1" style="font-size: 0.75rem;"></label>
                            <input asp-for="ImagenUrl" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" placeholder="https://..." />
                            <span asp-validation-for="ImagenUrl" class="text-danger small"></span>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary fw-bold py-2 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Guardar Producto
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary text-white-50 border-secondary py-2">
                                <i class="bi bi-arrow-left me-1"></i> Volver al Listado
                            </a>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
