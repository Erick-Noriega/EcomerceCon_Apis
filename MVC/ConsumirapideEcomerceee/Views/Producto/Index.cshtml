@model List<ProductoDtoParaAdmins>
<div class="card bg-dark border-secondary shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-black border-bottom border-secondary py-3 px-4 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-white fw-bold">
            <i class="bi bi-tag-fill text-primary me-2"></i>Listado de Ofertas / Productos
        </h5>
        <!-- Opcional: Un botón para crear nuevo si lo necesitas -->
        <a asp-action="Create" class="btn btn-primary btn-sm fw-bold px-3">
            <i class="bi bi-plus-lg me-1"></i> Nuevo
        </a>
    </div>

    <div class="table-responsive m-0">
        <table class="table table-dark table-hover align-middle mb-0 border-secondary">
            <thead class="table-black text-uppercase fs-7 text-secondary">
                <tr>
                    <th class="py-3 px-3">Id</th>
                    <th class="py-3">Nombre</th>
                    <th class="py-3">Categoría</th>
                    <th class="py-3">Cantidad</th>
                    <th class="py-3">Precio Original</th>
                    <th class="py-3">Precio con Oferta</th>
                    <th class="py-3 text-center">Oferta Disponible</th>
                    <th class="py-3 text-end px-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-3 fw-bold text-white-50">@Html.DisplayFor(model => item.Id)</td>
                        <td class="fw-semibold text-white">@Html.DisplayFor(model => item.Nombre)</td>
                        <td><span class="badge bg-secondary bg-opacity-25 text-light border border-secondary px-2 py-1">@Html.DisplayFor(model => item.CategoriaNombre)</span></td>
                        <td>@Html.DisplayFor(model => item.Cantidad)</td>
                        <td class="text-muted text-decoration-line-through">$@Html.DisplayFor(model => item.PrecioOriginal)</td>
                        <td class="fw-bold text-success">$@Html.DisplayFor(model => item.PrecioFinal)</td>
                        <td class="text-center">
                            @if (item.tieneoferta) // O ajusta esto según si es booleano o texto
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">No</span>
                            }
                        </td>
                        <td class="text-end px-3">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>