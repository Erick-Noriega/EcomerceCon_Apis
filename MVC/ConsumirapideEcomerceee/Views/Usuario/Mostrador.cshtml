<div class="container py-5 mb-5">
    <!-- Título de sección idéntico -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <span class="text-uppercase text-secondary small fw-bold tracking-wider" style="letter-spacing: 1px; font-size: 0.75rem;">CATÁLOGO OFICIAL</span>
            <h2 class="fw-bold text-white mb-0" style="font-size: 2rem;">Instrumentos & Periféricos</h2>
        </div>
    </div>

    <!-- Contenedor donde se renderizarán las tarjetas -->
    <div class="row row-cols-1 row-cols-md-3 g-4" id="contenedorProductos"></div>
</div>

<style>
    /* Estilos réplica exacta de la referencia */
    body {
        background-color: #0b0b0c !important;
        color: #f4f4f5;
    }

    .card-kinesis {
        background-color: #121215 !important;
        border: 1px solid #232329 !important;
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .card-kinesis:hover {
            transform: translateY(-4px);
            border-color: #3f3f46 !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
        }

    /* Ocupa todo el bloque superior y recorta bordes blancos de las fotos */
    .card-img-container {
        width: 100%;
        height: 220px;
        background-color: #09090b;
        position: relative;
        overflow: hidden;
    }

        .card-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* Ajusta la imagen al marco exactamente como el diseño */
            object-position: center;
            transition: transform 0.3s ease;
        }

    .card-kinesis:hover .card-img-container img {
        transform: scale(1.04);
    }

    .badge-kinesis {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: #a1a1aa;
        background-color: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 4px 8px;
        border-radius: 6px;
    }

    .product-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 4px;
    }

    .product-desc {
        color: #71717a;
        font-size: 0.825rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-kinesis-add {
        background-color: #ffffff;
        color: #000000;
        border: none;
        font-weight: 700;
        font-size: 0.85rem;
        border-radius: 8px;
        padding: 8px 16px;
        transition: background-color 0.2s ease, transform 0.1s ease;
    }

        .btn-kinesis-add:hover {
            background-color: #e4e4e7;
            color: #000000;
        }

        .btn-kinesis-add:active {
            transform: scale(0.97);
        }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        cargarProductos();
    });

    async function cargarProductos() {
        try {
            const response = await fetch('http://localhost:5093/api/Producto/Lista');

            if (!response.ok) {
                console.error("Error al obtener los productos. Status HTTP:", response.status);
                return;
            }

            const productos = await response.json();
            const contenedor = document.getElementById('contenedorProductos');
            contenedor.innerHTML = '';

            productos.forEach(prod => {
                const id = prod.id;
                const nombre = prod.nombre || 'Sin nombre';
                const imagenUrl = prod.imagenUrl || 'https://via.placeholder.com/300x200?text=Sin+Imagen';
                const descripcion = prod.descripcion || '';
                const categoriaNombre = prod.categoriaNombre || 'GENERAL';
                const precioOriginal = prod.precioOriginal;
                const precioFinal = prod.precioFinal;
                const tieneOferta = prod.tieneOferta;

                const cardHtml = `
                    <div class="col">
                        <div class="card card-kinesis h-100 border-0 shadow">

                            <!-- Imagen en bloque superior cubriendo el contenedor -->
                            <div class="card-img-container">
                                <img src="${imagenUrl}"
                                     alt="${nombre}"
                                     onerror="this.onerror=null; this.src='https://via.placeholder.com/300x200?text=Sin+Imagen';">
                            </div>

                            <!-- Cuerpo de la tarjeta -->
                            <div class="card-body d-flex flex-column p-4">
                                <div class="mb-2">
                                    <span class="badge badge-kinesis">${categoriaNombre}</span>
                                </div>

                                <h5 class="product-title">${nombre}</h5>
                                <p class="product-desc flex-grow-1">${descripcion}</p>

                                <!-- Fila inferior: Precio e Iniciar acción -->
                                <div class="d-flex align-items-end justify-content-between pt-3 mt-auto border-top border-dark border-opacity-50">
                                    <div class="d-flex flex-column">
                                        <span class="text-secondary" style="font-size: 0.7rem; font-weight: 600;">PRECIO</span>
                                        <div class="d-flex align-items-baseline">
                                            ${tieneOferta
                                                ? `<span class="fs-5 fw-bold text-white me-2">$${precioFinal}</span>                                                    <span class="text-decoration-line-through text-secondary small" style="font-size: 0.75rem;">$${precioOriginal}</span>`
                                                : `<span class="fs-5 fw-bold text-white">$${precioOriginal}</span>`
                                            }
                                        </div>
                                    </div>

                                    <button type="button" class="btn btn-kinesis-add d-flex align-items-center gap-1" onclick="agregarAlCarrito(${id})">
                                        🛒 Añadir
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                `;
                contenedor.innerHTML += cardHtml;
            });

        } catch (error) {
            console.error("Error de conexión con el backend:", error);
        }
    }

    async function agregarAlCarrito(id) {
        try {
            // Llama directamente al Controller de MVC (puerto 5023)
            const respuesta = await fetch('/DetaleCarrito/Create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productoId: id,
                    cantidad: 1
                })
            });

            if (respuesta.ok) {
                alert("¡Producto agregado al carrito!");
            } else if (respuesta.status === 401) {
                alert("Debes iniciar sesión para agregar productos al carrito.");
                window.location.href = "/Account/Login";
            } else {
                const error = await respuesta.text();
                alert("Error: " + error);
            }
        } catch (error) {
            console.error("Error en la petición:", error);
        }
    }
</script>